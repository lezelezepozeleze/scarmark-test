{
  "id": "scarmark-test",
  "title": "scarmark-test",
  "description": "Vlastní TTRPG systém pro Foundry VTT. Nízko-magický, mechanicky štíhlý, roleplay-first.",
  "version": "1.1.3-beta",
  "compatibility": {
    "minimum": "14",
    "verified": "14.369"
  },
  "grid": {
    "distance": 1,
    "units": "m"
  },
  "relationships": {
    "recommends": [
      {
        "id": "foundryvtt-simple-calendar-reborn",
        "type": "module",
        "manifest": "https://github.com/Fireblight-Studios/foundryvtt-simple-calendar/releases/latest/download/module.json",
        "reason": "Advances in-game time. Many Scarmark Active Effects are timed and only expire when world time moves forward."
      },
      {
        "id": "smalltime",
        "type": "module",
        "manifest": "https://github.com/unsoluble/smalltime/releases/latest/download/module.json",
        "reason": "Compact clock for advancing in-game time, so timed Active Effects expire."
      }
    ]
  },
  "authors": [
    {
      "name": "Daniel"
    }
  ],
