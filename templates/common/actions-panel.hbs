{{!-- The Actions panel: one "when <trigger> add effect / roll test, on <target>" row per action, with the Add link. Parameter: panel - the view model from prepareActionsPanel (sheets/actions/action-panel.mjs). Not tied to item sheets: the data path comes from panel.path. The "on" roll-down (and the item picker) only show for a trigger that asks for a target. --}}
<div class="actions-panel" data-actions-path="{{panel.path}}">
  <div class="actions-header">
    <a class="add-action" data-action="createAction">
      <i class="fa-solid fa-plus"></i> {{localize 'SCARMARK.Add'}}
    </a>
  </div>
  <ol class="actions-list">
    {{#each panel.rows as |row index|}}
    <li class="action-entry" data-index="{{index}}">
      <input type="hidden" name="{{row.prefix}}.id" value="{{row.id}}" />
      <span class="action-word">{{localize 'SCARMARK.Action.when'}}</span>
      <select class="action-when" name="{{row.when.name}}">
        {{#each row.when.options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      <select class="action-kind" name="{{row.kind.name}}">
        {{#each row.kind.options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{#if row.isTest}}
      <select class="action-test" name="{{row.test.name}}">
        <option value=""{{#if row.test.blankSelected}} selected{{/if}}></option>
        {{#each row.test.groups}}
        <optgroup label="{{label}}">
          {{#each options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
        </optgroup>
        {{/each}}
      </select>
      {{else}}
      <select class="action-effect" name="{{row.effect.name}}">
        <option value=""{{#if row.effect.blankSelected}} selected{{/if}}></option>
        {{#each row.effect.groups}}
        <optgroup label="{{label}}">
          {{#each options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
        </optgroup>
        {{/each}}
      </select>
      {{/if}}
      {{#if row.showOn}}
      <span class="action-word">{{localize 'SCARMARK.Action.on'}}</span>
      <select class="action-on" name="{{row.on.name}}">
        {{#each row.on.options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{/if}}
      {{#if row.showItem}}
      <select class="action-item" name="{{row.targetItem.name}}">
        {{#each row.targetItem.options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{/if}}
      <a class="action-delete" data-action="deleteAction" title="{{localize 'SCARMARK.Delete'}}"><i class="fa-solid fa-trash"></i></a>
    </li>
    {{/each}}
    {{#unless panel.rows.length}}
    <li class="action-empty">{{localize 'SCARMARK.Action.none'}}</li>
    {{/unless}}
  </ol>
</div>
