{{!-- The Actions panel: one "when <trigger> <do> ..." row per action, with the Add link. Parameter: panel - the view model from prepareActionsPanel (sheets/actions/action-panel.mjs). Not tied to item sheets: the data path comes from panel.path. What follows "do" depends on it: an effect (and "on" for a trigger that asks for a target), a test, an alteration with its item (and the effect of an improve), or a message text. --}}
<div class="actions-panel" data-actions-path="{{panel.path}}">
  <div class="actions-header">
    <a class="add-action" data-action="createAction">
      <i class="fa-solid fa-plus"></i> {{localize 'SCARMARK.Add'}}
    </a>
  </div>
  <ol class="actions-list">
    {{#each panel.rows as |row index|}}
    <li class="action-entry" data-index="{{index}}">
      <input type="hidden" name="{{row.prefix}}.id" value="{{row.id}}" />
      <span class="action-word">{{localize 'SCARMARK.Action.when'}}</span>
      {{> "systems/scarmark-test/templates/common/roll-down.hbs" field=row.when cls="action-when"}}
      {{> "systems/scarmark-test/templates/common/roll-down.hbs" field=row.kind cls="action-kind"}}
      {{#if row.isTest}}
      {{> "systems/scarmark-test/templates/common/roll-down.hbs" field=row.test cls="action-test"}}
      {{/if}}
      {{#if row.isAlter}}
      {{> "systems/scarmark-test/templates/common/roll-down.hbs" field=row.alteration cls="action-alteration"}}
      {{/if}}
      {{#if row.showEffect}}
      {{> "systems/scarmark-test/templates/common/roll-down.hbs" field=row.effect cls="action-effect"}}
      {{/if}}
      {{#if row.isMessage}}
      <input type="text" class="action-message" name="{{row.message.name}}" value="{{row.message.value}}" placeholder="{{localize 'SCARMARK.Action.messagePlaceholder'}}" />
      {{/if}}
      {{#if row.showOn}}
      <span class="action-word">{{localize 'SCARMARK.Action.on'}}</span>
      {{> "systems/scarmark-test/templates/common/roll-down.hbs" field=row.on cls="action-on"}}
      {{/if}}
      {{#if row.showItem}}
      <span class="action-word">{{localize 'SCARMARK.Action.on'}}</span>
      {{> "systems/scarmark-test/templates/common/roll-down.hbs" field=row.targetItem cls="action-item"}}
      {{/if}}
      <a class="action-delete" data-action="deleteAction" title="{{localize 'SCARMARK.Delete'}}"><i class="fa-solid fa-trash"></i></a>
    </li>
    {{/each}}
    {{#unless panel.rows.length}}
    <li class="action-empty">{{localize 'SCARMARK.Action.none'}}</li>
    {{/unless}}
  </ol>
</div>
