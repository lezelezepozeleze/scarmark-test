{{!-- The one-line Notes field of an item. Parameter: cls - the extra class of the field (note, skill-note, trait-note). --}}
<div class="field {{cls}}">
  <label class="plain-label">{{localize 'SCARMARK.Trait.note'}}</label>
  <input type="text" name="system.notes" value="{{system.notes}}" />
</div>
