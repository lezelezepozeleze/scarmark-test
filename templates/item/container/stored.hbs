<div class="tab stored{{#if tab.active}} active{{/if}}" data-group="primary" data-tab="stored">

  <div class="stored-capacity{{#if overCapacity}} over{{/if}}">
    {{localize 'SCARMARK.Container.loadedLine' value=(round1 contentWeight) max=(round1 system.maxCapacity)}}
  </div>

  <ol class="gear-list stored-list">
    {{#each storedItems as |item|}}
    <li class="gear-entry" data-item-id="{{item.id}}">
      <span class="col-name">
        <img class="gear-icon" src="{{item.img}}" alt="" />
        <a data-action="openStored">{{item.name}}</a>
      </span>
      <span class="col-qty">{{item.system.quantity}}</span>
      <span class="col-weight">{{num item.system.totalWeight}}</span>
      <span class="col-actions">
        <a data-action="ejectStored" title="{{localize 'SCARMARK.Container.unpack'}}"><i class="fa-solid fa-arrow-up-from-bracket"></i></a>
      </span>
    </li>
    {{/each}}
    {{#unless storedItems.length}}
    <li class="gear-empty">{{localize 'SCARMARK.Container.noStored'}}</li>
    {{/unless}}
  </ol>

</div>
